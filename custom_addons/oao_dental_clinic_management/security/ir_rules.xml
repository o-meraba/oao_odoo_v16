<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <data noupdate="1">
    <record id="rule_patient_appointment_dentist_only" model="ir.rule">
        <field name="name">Patients Appointments Only for Assigned Dentist</field>
        <field name="model_id" ref="oao_dental_clinic_management.model_patient_appointment"/>
        <field name="domain_force">[('dentist_id.related_user', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('oao_dental_clinic_management.group_dental_clinic_dentists'))]"/>
    </record>

    <record id="rule_patient_dentist_only" model="ir.rule">
        <field name="name">Patients Only for Assigned Dentist</field>
        <field name="model_id" ref="oao_dental_clinic_management.model_patient_patient"/>
        <field name="domain_force">[('dentist_id.related_user', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('oao_dental_clinic_management.group_dental_clinic_dentists'))]"/>
    </record>

    <record id="rule_appointment_requests_dentist_only" model="ir.rule">
        <field name="name">Appointment Requests Only for Assigned Dentist</field>
        <field name="model_id" ref="oao_dental_clinic_management.model_appointment_requests"/>
        <field name="domain_force">[('dentist_id.related_user', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('oao_dental_clinic_management.group_dental_clinic_dentists'))]"/>
    </record>

    <record id="rule_clinic_employees_dentist_only" model="ir.rule">
        <field name="name">Clinic Employee Only for Employee</field>
        <field name="model_id" ref="oao_dental_clinic_management.model_clinic_employee"/>
        <field name="domain_force">[('related_user', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('oao_dental_clinic_management.group_dental_clinic_employee'))]"/>
    </record>
  </data>
</odoo>
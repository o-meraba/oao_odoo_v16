#. module: oao_dental_clinic_management
#: model:mail.template,body_html:oao_dental_clinic_management.email_template_appointment_details
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"box-sizing:border-box;margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                          Dear <t t-out=\"object.patient_id.name\"></t> <t t-out=\"object.patient_id.surname\"></t>,\n"
"                    </p>\n"
"                    <p style=\"box-sizing:border-box;margin: 10px 0; padding: 0px; font-size: 13px;\">\n"
"                        We would like to confirm your dental appointment details:\n"
"                    </p>\n"
"                    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                        Appointment Date : <t t-out=\"object.start\"></t> <br>\n"
"                        Dentist : <t t-out=\"object.dentist_id.name\"></t> <t t-out=\"object.dentist_id.surname\"></t> <br>\n"
"                        Urgency Level : <t t-out=\"object.urgency_level\"></t>\n"
"                    </p>\n"
"                     <p style=\"margin:10px 0 12px 0;box-sizing:border-box;margin-top: 10px; font-size: 13px;\">\n"
"                        Please make sure to arrive 10 minutes prior to your appointment. If you need to reschedule, kindly contact us as soon as possible.\n"
"                    </p>\n"
"                    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size: 13px;\">\n"
"                        Best regards,<br>\n"
"                        Your Dental Clinic Team\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"box-sizing:border-box;margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                          Sayın <t t-out=\"object.patient_id.name\"></t> <t t-out=\"object.patient_id.surname\"></t>,\n"
"                    </p>\n"
"                    <p style=\"box-sizing:border-box;margin: 10px 0; padding: 0px; font-size: 13px;\">\n"
"                        Diş randevunuzun detaylarını onaylamak istiyoruz:\n"
"                    </p>\n"
"                    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                        Randevu Tarihi : <t t-out=\"object.start\"></t> <br>\n"
"                        Diş Hekimi : <t t-out=\"object.dentist_id.name\"></t> <t t-out=\"object.dentist_id.surname\"></t> <br>\n"
"                        Aciliyet Seviyesi : <t t-out=\"object.urgency_level\"></t>\n"
"                    </p>\n"
"                     <p style=\"margin:10px 0 12px 0;box-sizing:border-box;margin-top: 10px; font-size: 13px;\">\n"
"                        Lütfen randevunuza 10 dakika erken gelmeyi unutmayın. Yeniden planlama gerekiyorsa, lütfen mümkün olan en kısa sürede bizimle iletişime geçin.\n"
"                    </p>\n"
"                    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;font-size: 13px;\">\n"
"                        Saygılarımızla,<br>\n"
"                        Diş Kliniği Ekibiniz\n"
"                    </p>\n"
"                </div>\n"
"            "


<odoo>
    <record id="menu_patient_appointment_form" model="website.menu">
        <field name="name">Create Appointment</field>
        <field name="url">/patient_appointment</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence">10</field>
    </record>

    <template id="patient_appointment_template" name="Patient Appointment Page">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">
                    <div class="container">
                        <h2 class="text-center">Create Appointment</h2>
                        <form role="form" action="/create/webappointment" method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="form-group">
                                <label for="name" class="control-label">Name</label>
                                <input type="text" name="name" t-att-value="name" id="name" class="form-control" placeholder="Ahmet" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="surname" class="control-label">Surname</label>
                                <input type="text" name="surname" t-att-value="surname" id="surname" class="form-control" placeholder="Demir" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="birthdate" class="control-label">Date of Birth</label>
                                <input type="date" name="birthdate" id="birthdate" class="form-control" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="phone" class="control-label">Phone</label>
                                <input type="text" name="phone" t-att-value="phone" id="phone" class="form-control" placeholder="5456929948" required="required"/>
                            </div>
                            <div class="form-group">
                                <label for="email" class="control-label">E-posta</label>
                                <input type="email" name="email" t-att-value="email" id="email" class="form-control" placeholder="example123@example.com"/>
                            </div>
                            <div class="form-group">
                                <label for="dentist" class="control-label">Select Dentist</label>
                                <select name="dentist_id" id="dentist" class="form-control" required="required">
                                    <option value="">-- Select Dentist --</option>
                                    <t t-foreach="dentists" t-as="dentist">
                                        <option t-att-value="dentist.id" t-esc="dentist.name + ' ' + dentist.surname"/>
                                    </t>
                                </select>
                            </div>
                            <div class="clearfix_oe_on_login_buttons">
                                <button type="submit" class="btn btn-primary btn-lg btn-block">Create Appointment</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <record id="patient_thanks" model="website.page">
        <field name="name">Thanks</field>
        <field name="type">qweb</field>
        <field name="url">/patient-thank-you</field>
        <field name="website_published">True</field>
        <field name="key">oao_dental_clinic_management.patient_thanks</field>
        <field name="arch" type="xml">
            <t name="Thanks" t-name="oao_dental_clinic_management.patient_thanks">
                <t t-call="website.layout">
                    <div id="wrap">
                        <div class="container">
                            <h1>Thanks!</h1>
                            <div class="row">
                                <div class="col-lg-8">
                                    <div class="alert alert-success" role="status">
                                        The Appointment has been Created successfully.
                                    </div>
                                    <p>We will call you soon.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </field>
    </record>
</odoo>